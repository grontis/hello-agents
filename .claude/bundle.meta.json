{
  "id": "standard",
  "version": "1.2.0",
  "description": "the task pipeline (architect -> coder -> code-reviewer -> qa -> pr) plus the project stages (spec conversation -> task generation)",
  "docs": "https://github.com/grontis/hello-agents",
  "stages": [
    {
      "key": "PLAN",
      "agent": "architect",
      "command": "/architect",
      "artifactGlob": ".agentwork/architect/PLAN_*.md",
      "statuses": {
        "accept": [
          "proposed",
          "ready"
        ],
        "blocking": [],
        "inProgress": [
          "draft",
          "changes-required"
        ]
      }
    },
    {
      "key": "IMPLEMENT",
      "agent": "coder",
      "command": "/implement",
      "artifactGlob": ".agentwork/coder/IMPLEMENTATION_*.md",
      "statuses": {
        "accept": [
          "implemented",
          "blocked"
        ],
        "blocking": [
          "blocked"
        ],
        "inProgress": []
      }
    },
    {
      "key": "REVIEW",
      "agent": "code-reviewer",
      "command": "/review-code",
      "artifactGlob": ".agentwork/code-review/CODE_REVIEW_*.md",
      "statuses": {
        "accept": [
          "approved",
          "changes-required",
          "needs-discussion"
        ],
        "blocking": [
          "changes-required",
          "needs-discussion"
        ],
        "inProgress": []
      }
    },
    {
      "key": "QA",
      "agent": "qa",
      "command": "/qa",
      "artifactGlob": ".agentwork/qa/QA_REPORT_*.md",
      "statuses": {
        "accept": [
          "pass",
          "pass-with-notes",
          "fail"
        ],
        "blocking": [
          "fail"
        ],
        "inProgress": []
      }
    },
    {
      "key": "PR",
      "agent": "pr",
      "command": "/open-pr",
      "artifactGlob": ".agentwork/pr/PR_*.md",
      "statuses": {
        "accept": [
          "opened",
          "updated",
          "blocked"
        ],
        "blocking": [
          "blocked"
        ],
        "inProgress": []
      }
    },
    {
      "key": "SPEC",
      "agent": "",
      "command": "/author-spec",
      "artifactGlob": ".agentwork/spec-author/PROJECT_SPEC_*.md",
      "statuses": {
        "accept": [
          "proposed"
        ],
        "blocking": [],
        "inProgress": [
          "draft"
        ]
      }
    },
    {
      "key": "TASK_GEN",
      "agent": "task-planner",
      "command": "/generate-tasks",
      "artifactGlob": ".agentwork/task-planner/TASKS_*.yaml",
      "statuses": {
        "accept": [
          "proposed",
          "blocked"
        ],
        "blocking": [
          "blocked"
        ],
        "inProgress": [
          "draft"
        ]
      }
    }
  ]
}
