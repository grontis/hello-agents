{
  "permissions": {
    "allow": [
      "Write(.agentwork/**)",
      "Edit(.agentwork/**)",
      "Write(.claude/agent-memory/**)",
      "Edit(.claude/agent-memory/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "architect|architect-deep|coder|code-reviewer|qa",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/progress-log.mjs\" start" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "architect|architect-deep|coder|code-reviewer|qa",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/progress-log.mjs\" stop" }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "implement|review-code|qa",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/gateway.mjs\"" }
        ]
      }
    ]
  }
}
